{
  "name": "dividr-mobile-server",
  "private": true,
  "version": "0.1.0",
  "description": "Backend for Dividr Mobile. Wraps ../../src/backend (FFmpeg / Whisper / media-tools / mycelium agent) and exposes it over HTTP + WebSocket so a phone can drive it.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/ws": "^8.5.10",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
